# ==============================================================================
# Full-Stack AI Chatbot with MCP - Environment Configuration Template
# Copy this file to .env and configure your preferences and API keys.
# NEVER commit your real .env file — it is ignored by .gitignore.
# ===============================================================================

# Application Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-key-123456

# Database Configuration (PostgreSQL for Docker, SQLite for local dev)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mcp_chatbot
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mcp_chatbot
# Local SQLite Alternative:
# DATABASE_URL=sqlite+aiosqlite:///./chatbot.db

# Redis Caching
REDIS_URL=redis://localhost:6379/0
REDIS_DEFAULT_TTL=300
WEATHER_CACHE_TTL=600
DOC_CACHE_TTL=300

# Model Context Protocol (MCP) Server Endpoints
MCP_SERVER_URL=http://localhost:8001/sse
MCP_SERVER_EXEC_URL=http://localhost:8001/api/tools/execute

# Default LLM Provider and Model
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=openai/gpt-4o-mini
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048
DEFAULT_MEMORY_WINDOW=10

# LLM Provider API Keys (Can also be set dynamically in the UI Settings modal)
# Keys entered in the UI are encrypted at rest using AES-256 and never returned in plain text.
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
